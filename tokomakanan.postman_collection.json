                "login"
              ],
              "query": []
            },
            "description": "Login akun default superadmin. Otomatis menyimpan token JWT ke variabel koleksi.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@tokomakanan.com\",\n  \"password\": \"SuperAdmin123!\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.token) {",
                  "        pm.collectionVariables.set(\"token\", res.data.token);",
                  "        console.log(\"Token JWT berhasil disimpan ke collection variable 'token'\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
